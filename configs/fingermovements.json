{
  "data": {
    "dataset_name": "FingerMovements",
    "data_dir": "./data/datasets",
    "normalize": true,
    "batch_size": 32,
    "val_ratio": 0.2,
    "num_workers": 0,
    "seq_len": 50,
    "n_vars": 28,
    "num_classes": 2
  },
  "model": {
    "d_model": 128,
    "dropout": 0.1,
    "stage3_dropout": 0.1,
    "scales": [
      1,
      2,
      4
    ],
    "patch_len": 8,
    "stride": 2,
    "n_heads": 4,
    "n_layers": 2,
    "d_ff_multiplier": 2,
    "codebook_size": 64,
    "num_quantize_layers": 3,
    "ema_decay": 0.99,
    "gpt2_model": "./pretrained/gpt2",
    "use_pretrained_gpt2": true,
    "freeze_gpt2": false,
    "unfreeze_layers": 12,
    "deep_classifier": true,
    "bypass_gpt2_cls": false
  },
  "training": {
    "grad_clip": 1.0,
    "scheduler_eta_min": 1e-06,
    "use_scheduler": true,
    "stage1_use_scheduler": true,
    "stage2_use_scheduler": true,
    "stage3_use_scheduler": false,
    "stage1_epochs": 150,
    "stage1_lr": 0.001,
    "stage1_weight_decay": 0.0001,
    "stage1_patience": 150,
    "mixup_alpha": 0.4,
    "label_smoothing": 0.1,
    "stage2_epochs": 50,
    "stage2_lr": 0.001,
    "stage2_weight_decay": 0.0001,
    "stage3_epochs": 200,
    "stage3_lr": 1e-05,
    "stage3_weight_decay": 0.0001,
    "stage3_patience": 80,
    "num_runs": 1,
    "merge_resplit": true,
    "loss_weight_code1": 1.0,
    "loss_weight_code2": 1.0,
    "loss_weight_code3": 1.0,
    "loss_weight_label": 20.0,
    "stage3_mixup_alpha": 0.0
  },
  "checkpoint_dir": "./checkpoints"
}
